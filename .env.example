# API URL (used by the frontend to make requests)
NEXT_PUBLIC_LATTICE_API=http://localhost:8000

# Build-time: the release reported on every Monitor event (CI passes the tag
# vX.Y.Z or the short commit SHA). Unset = "dev".
# NEXT_PUBLIC_APP_VERSION=dev

# ─── Monitor telemetry (runtime, server-only — never NEXT_PUBLIC_) ──────────
# Read by /api/monitor (the browser relay) and instrumentation.ts. Leave the
# first two unset to disable: the relay then accepts and discards events.
# Monitor ingest endpoint of the appleby zone, e.g. https://<zone>/v1/events
MONITOR_INGEST_URL=
# Ingest-scoped API key minted on that zone. Stays on the server.
MONITOR_API_KEY=
# `env` of server-side events (default: production)
MONITOR_ENV=development
